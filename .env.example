# Telegram
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Telegram user IDs allowed to use the bot (comma-separated). Get yours from @userinfobot.
ADMIN_CHAT_IDS=111111111,222222222

# Keycloak
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=telegram-bot
KEYCLOAK_CLIENT_SECRET=replace-with-service-account-client-secret
KEYCLOAK_VERIFY_SSL=true

# How often (seconds) to poll Keycloak for newly registered users / login events
POLL_INTERVAL_SECONDS=60

# Notification toggles — default state at container startup.
# Can be flipped at runtime via the bot's /settings command.
NOTIFY_NEW_USERS=true
# Requires "Events" (User events, type LOGIN) enabled in Keycloak's realm settings — see README.
NOTIFY_LOGINS=false

# Whether /settings toggles survive a container restart (written to data/settings.json).
# Keep "false" on ephemeral storage (e.g. Kubernetes without a mounted volume) — toggles
# will just fall back to the env defaults above on every restart instead of failing to persist.
# Set "true" when data/ is a real mounted volume (e.g. the docker-compose named volume).
PERSIST_SETTINGS=false
